# <<<<<<<<<<<< APPLICATION environment variables >>>>>>>>>>>>

# ------------ HashiCorp Vault ------------
VAULT_TOKEN=my-root-token

# ------------ Mongo ------------
TERRA_VISION__MONGO__ROOT_USERNAME=admin
TERRA_VISION__MONGO__ROOT_PASSWORD=admin

# ------------ Redis ------------
TERRA_VISION__REDIS__PASSWORD=adminpassword

# ------------ Postgres ------------
TERRA_VISION__POSTGRES__USER=postgres
TERRA_VISION__POSTGRES__PASSWORD=postgres

# ------------ Postgis ------------
TERRA_VISION__POSTGIS__USER=postgis
TERRA_VISION__POSTGIS__PASSWORD=postgis

# ------------ Minio ------------
TERRA_VISION__MINIO__ROOT_USER=minioadmin
TERRA_VISION__MINIO__ROOT_PASSWORD=minioadmin



# <<<<<<<<<<<< DEV TOOLS environment variables >>>>>>>>>>>>

# ------------ pgAdmin ------------
TERRA_VISION__PGADMIN__DEFAULT_EMAIL=admin@admin.com
TERRA_VISION__PGADMIN__DEFAULT_PASSWORD=admin

# ------------ Mongo Express ------------
# TERRA_VISION__MONGO__ROOT_USERNAME=admin # (Already defined)
# TERRA_VISION__MONGO__ROOT_PASSWORD=admin # (Already defined)
TERRA_VISION__MONGO_EXPRESS__USERNAME=admin
TERRA_VISION__MONGO_EXPRESS__PASSWORD=admin